(module PogoPad_1x03_P2.54mm (layer F.Cu) (tedit 65F0A000)
	(descr "3-pin pogo/test pad array for UART debug (2.54mm pitch). Bare copper exposed (F.Mask opened), no solder paste. Place near PCB edge.")
	(tags "pogo test uart debug")
	(attr smd)
	(fp_text reference REF** (at 0 -3.8) (layer F.SilkS)
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(fp_text value PogoPad_1x03 (at 0 3.8) (layer F.Fab)
		(effects (font (size 0.8 0.8) (thickness 0.12)))
	)
	(fp_text user %R (at 0 0) (layer F.Fab)
		(effects (font (size 0.8 0.8) (thickness 0.12)))
	)
	(fp_text user "TX" (at -2.54 2.2) (layer F.SilkS)
		(effects (font (size 0.8 0.8) (thickness 0.12)))
	)
	(fp_text user "RX" (at 0 2.2) (layer F.SilkS)
		(effects (font (size 0.8 0.8) (thickness 0.12)))
	)
	(fp_text user "GND" (at 2.54 2.2) (layer F.SilkS)
		(effects (font (size 0.8 0.8) (thickness 0.12)))
	)
	(pad 1 smd rect (at -2.54 0 0) (size 1.5 2.5) (layers F.Cu F.Mask))
	(pad 2 smd rect (at 0 0 0) (size 1.5 2.5) (layers F.Cu F.Mask))
	(pad 3 smd rect (at 2.54 0 0) (size 1.5 2.5) (layers F.Cu F.Mask))
)
