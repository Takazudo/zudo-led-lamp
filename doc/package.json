{
  "name": "doc",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm generate:components && run-parallel dev:zfb dev:history dev:components",
    "dev:network": "pnpm generate:components && run-parallel dev:zfb:network dev:history dev:components",
    "dev:zfb": "zfb dev",
    "dev:zfb:network": "zfb dev --host 0.0.0.0",
    "dev:history": "INIT_CWD=\"$PWD\" doc-history-server --port 4322 --content-dir src/content/docs",
    "dev:components": "zudo-circuit-doc generate --watch --config ../circuit.config.ts",
    "build": "pnpm --dir .. build",
    "build:site": "INIT_CWD=\"$PWD\" zfb build",
    "preview": "zfb preview",
    "check": "zfb check",
    "check:wind": "zfb wind audit --project-root . --fail-on error",
    "generate:enclosure-viewer": "node enclosure-viewer/build.mjs",
    "check:enclosure-viewer": "node enclosure-viewer/check-geometry.mjs",
    "generate:components": "zudo-circuit-doc generate --config ../circuit.config.ts",
    "check:components": "zudo-circuit-doc check --config ../circuit.config.ts",
    "generate:models": "zudo-circuit-doc models --config ../circuit.config.ts",
    "check:models": "zudo-circuit-doc models --check --config ../circuit.config.ts",
    "generate:footprint-previews": "zudo-circuit-doc footprints generate --config ../circuit.config.ts",
    "check:footprint-previews": "zudo-circuit-doc footprints check --config ../circuit.config.ts",
    "check:built-component-references": "zudo-circuit-doc check-built --config ../circuit.config.ts",
    "scan:artifacts": "zudo-circuit-doc scan --config ../circuit.config.ts",
    "scan:doc-skill": "bash scripts/scan-doc-skill.sh",
    "check:mermaid": "node scripts/check-mermaid.mjs",
    "test:model-viewer:browser": "zudo-circuit-doc check-browser --shell-assertions --search-assertions --config ../circuit.config.ts",
    "check:links": "node scripts/check-links.js",
    "check:images": "zudo-doc check images",
    "check:anchors": "node scripts/check-links.js --strict-anchors",
    "setup:doc-skill": "bash scripts/setup-doc-skill.sh",
    "setup:doc-skill-silent": "bash scripts/setup-doc-skill.sh --silent",
    "setup:doc-skill:claude": "bash scripts/setup-doc-skill.sh --target claude",
    "setup:doc-skill:codex": "bash scripts/setup-doc-skill.sh --target codex",
    "setup:doc-skill:both": "bash scripts/setup-doc-skill.sh --target both",
    "b4push": "pnpm --dir .. b4push",
    "test:scripts": "node --test scripts/tests/*.test.mjs"
  },
  "dependencies": {
    "@takazudo/zfb": "5.2.2",
    "@takazudo/zfb-adapter-cloudflare": "5.2.2",
    "@takazudo/zfb-md-wasm": "5.2.2",
    "@takazudo/zfb-runtime": "5.2.2",
    "@takazudo/zudo-circuit-doc": "^0.3.0",
    "@takazudo/zudo-doc": "9.1.4",
    "@takazudo/zudo-doc-history-server": "9.1.4",
    "diff": "^8.0.3",
    "three": "0.185.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "0.185.3",
    "esbuild": "0.28.2",
    "mermaid": "11.17.2",
    "typescript": "^5.9.0",
    "wrangler": "4.114.0"
  }
}
