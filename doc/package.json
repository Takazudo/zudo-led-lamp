{
  "name": "doc",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm generate:components && run-p dev:zfb dev:history dev:components",
    "build": "pnpm generate:components && zfb build",
    "preview": "zfb preview",
    "check": "zfb check",
    "dev:zfb": "zfb dev",
    "dev:zfb:network": "zfb dev --host 0.0.0.0",
    "dev:network": "pnpm generate:components && run-p dev:zfb:network dev:history dev:components",
    "dev:history": "doc-history-server --port 4322 --content-dir src/content/docs",
    "generate:components": "node --experimental-strip-types component-docs/cli/generate.ts",
    "check:components": "node --experimental-strip-types component-docs/cli/check.ts",
    "generate:footprint-previews": "node --experimental-strip-types component-docs/footprint-previews/generate.ts",
    "check:footprint-previews": "node --experimental-strip-types component-docs/footprint-previews/check.ts",
    "scan:artifacts": "node --experimental-strip-types component-docs/cli/scan-artifacts.ts",
    "scan:doc-skill": "bash component-docs/scripts/scan-doc-skill.sh",
    "test:components": "node --experimental-strip-types --test \"component-docs/tests/*.test.ts\"",
    "dev:components": "node --experimental-strip-types component-docs/cli/generate.ts --watch",
    "setup:doc-skill": "bash scripts/setup-doc-skill.sh",
    "setup:doc-skill-silent": "bash scripts/setup-doc-skill.sh --silent",
    "setup:doc-skill:claude": "bash scripts/setup-doc-skill.sh --target claude",
    "setup:doc-skill:codex": "bash scripts/setup-doc-skill.sh --target codex",
    "setup:doc-skill:both": "bash scripts/setup-doc-skill.sh --target both",
    "b4push": "pnpm check && pnpm test:components && pnpm check:footprint-previews && pnpm build && pnpm check:components && pnpm scan:artifacts && pnpm scan:doc-skill"
  },
  "dependencies": {
    "@takazudo/zdtp": "0.4.9",
    "@takazudo/zfb": "0.1.0-next.96",
    "@takazudo/zfb-adapter-cloudflare": "0.1.0-next.96",
    "@takazudo/zfb-md-wasm": "0.1.0-next.96",
    "@takazudo/zfb-runtime": "0.1.0-next.96",
    "@takazudo/zudo-doc": "^4.4.6",
    "@takazudo/zudo-doc-history-server": "^4.4.6",
    "diff": "^8.0.3",
    "gray-matter": "^4.0.0",
    "katex": "^0.16.38",
    "mdast-util-gfm-table": "^2.0.0",
    "mdast-util-mdx": "^3.0.0",
    "mdast-util-to-markdown": "^2.1.2",
    "mermaid": "^11.12.3",
    "minisearch": "^7.2.0",
    "preact": "^10.29.1",
    "preact-render-to-string": "^6.6.6",
    "remark-cjk-friendly": "^2.0.1",
    "remark-directive": "^3.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "npm-run-all2": "^7.0.2",
    "pagefind": "^1.4.0",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.0",
    "wrangler": "4.114.0"
  }
}
